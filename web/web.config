<?xml version="1.0" encoding="utf-8"?>
<!--
  web.config dành cho IIS host Flutter Web (static SPA).
  Copy file này vào cùng thư mục với index.html sau khi flutter build web.
  Yêu cầu: IIS có cài module URL Rewrite (https://www.iis.net/downloads/microsoft/url-rewrite).
-->
<configuration>
  <system.webServer>

    <!-- Để Flutter SPA tự xử lý lỗi, không trả trang lỗi mặc định của IIS -->
    <httpErrors existingResponse="PassThrough" />

    <!-- MIME types bổ sung cho Flutter Web assets -->
    <staticContent>
      <!-- .wasm: WebAssembly (CanvasKit renderer) -->
      <remove fileExtension=".wasm" />
      <mimeMap fileExtension=".wasm" mimeType="application/wasm" />

      <!-- .json: manifest, asset manifest, version -->
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />

      <!-- .sym: source maps -->
      <remove fileExtension=".sym" />
      <mimeMap fileExtension=".sym" mimeType="text/plain" />
    </staticContent>

    <!-- Nén nội dung để tăng tốc tải trang -->
    <urlCompression doStaticCompression="true" doDynamicCompression="true" />

    <!--
      URL Rewrite: redirect mọi request không khớp file thực về index.html
      Điều này cho phép Flutter Web SPA hoạt động khi người dùng reload hoặc
      truy cập đường dẫn con trực tiếp.
    -->
    <rewrite>
      <rules>
        <rule name="Flutter SPA Fallback" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <!-- Chỉ rewrite nếu file được yêu cầu không tồn tại trên disk -->
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>

    <!-- Cache-Control hợp lý: cache asset dài hạn, không cache index.html -->
    <staticContent>
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
    </staticContent>

  </system.webServer>
</configuration>
