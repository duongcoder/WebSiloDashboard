<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>

      <!-- IMPORTANT: remove WebDAV components that can intercept OPTIONS preflight on IIS -->
      <modules>
        <remove name="WebDAVModule" />
      </modules>

      <handlers>
        <remove name="WebDAV" />
      </handlers>

      <!-- Keep standard ASP.NET Core hosting handler -->
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>

      <aspNetCore processPath="dotnet" arguments=".\Backend.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="InProcess" />

    </system.webServer>
  </location>
</configuration>

